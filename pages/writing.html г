 ["面包","Нон"],
 ["妈妈","Модар"],
 ["爸爸","Падар"],
 ["工作","Кор"],
 ["今天","Имрӯз"],
 ["明天","Пагоҳ"],
 ["我生病了。","Ман беморам."],
 ["你叫什么名字？","Номат чист?"],
 ["你好吗？","Аҳволат чӣ хел?"],
 ["火车站在哪儿？","Истгоҳи қатора дар куҷост?"]
 ],
 A2:[
 ["我今天必须工作。","Ман бояд имрӯз кор кунам."],
 ["我在找公寓。","Ман манзил меҷӯям."],
 ["我有预约。","Ман вақти қабул дорам."],
 ["我想预订一个房间。","Ман мехоҳам ҳуҷра банд кунам."],
 ["我在学习中文。","Ман чинӣ меомӯзам."],
 ["我需要帮助。","Ман ба ёрӣ ниёз дорам."],
 ["我昨天工作了。","Ман дирӯз кор кардам."],
 ["房租多少钱？","Иҷорапулӣ чанд аст?"],
 ["我需要转账。","Ман бояд пул интиқол диҳам."],
 ["你能再说一遍吗？","Метавонед инро такрор кунед?"]
 ]
},
ko:{
 A1:[
 ["안녕하세요","Салом"],
 ["좋은 아침이에요","Субҳ ба хайр"],
 ["감사합니다","Ташаккур"],
 ["부탁합니다","Лутфан"],
 ["물","Об"],
 ["빵","Нон"],
 ["어머니","Модар"],
 ["아버지","Падар"],
 ["일","Кор"],
 ["오늘","Имрӯз"],
 ["내일","Пагоҳ"],
 ["저는 아파요.","Ман беморам."],
 ["이름이 뭐예요?","Номат чист?"],
 ["잘 지내세요?","Аҳволат чӣ хел?"],
 ["기차역이 어디예요?","Истгоҳи қатора дар куҷост?"]
 ],
 A2:[
 ["오늘 일해야 해요.","Ман бояд имрӯз кор кунам."],
 ["아파트를 찾고 있어요.","Ман манзил меҷӯям."],
 ["예약이 있어요.","Ман вақти қабул дорам."],
 ["방을 예약하고 싶어요.","Ман мехоҳам ҳуҷра банд кунам."],
 ["한국어를 배우고 있어요.","Ман кореягӣ меомӯзам."],
 ["도움이 필요해요.","Ман ба ёрӣ ниёз дорам."],
 ["어제 일했어요.","Ман дирӯз кор кардам."],
 ["월세가 얼마예요?","Иҷорапулӣ чанд аст?"],
 ["돈을 송금해야 해요.","Ман бояд пул интиқол диҳам."],
 ["다시 말씀해 주시겠어요?","Метавонед инро такрор кунед?"]
 ]
}
};

let questions=[];
let index=0;
let score=0;
let answered=false;

function shuffle(a){
 const result=[...a];
 for(let i=result.length-1;i>0;i--){
  const j=Math.floor(Math.random()*(i+1));
  [result[i],result[j]]=[result[j],result[i]];
 }
 return result;
}

function normalize(s){
 return String(s)
 .trim()
 .normalize("NFKC")
 .toLocaleLowerCase()
 .replace(/[.!?。！？,،]/g,"")
 .replace(/\s+/g," ");
}

function renderXP(){
 $("xp").textContent=state.xp;
}

function start(){
 const lang=$("language").value;
 const level=$("level").value;

 questions=shuffle(DATA[lang][level]).slice(0,10);
 index=0;
 score=0;

 $("result").classList.add("hidden");
 $("exercise").classList.remove("hidden");
 $("score").textContent=0;

 showQuestion();
}

function showQuestion(){
 if(index>=questions.length){
  finish();
  return;
 }

 answered=false;

 $("counter").textContent=
 (index+1)+"/"+questions.length;

 $("bar").style.width=
 (index/questions.length*100)+"%";

 $("question").textContent=questions[index][1];
 $("answer").value="";
 $("answer").disabled=false;

 $("feedback").style.display="none";
 $("check").classList.remove("hidden");
 $("next").classList.add("hidden");

 $("answer").focus();
}

function check(){
 if(answered)return;

 const input=$("answer").value;
 if(!input.trim()){
  $("feedback").style.display="block";
  $("feedback").className="feedback wrong";
  $("feedback").textContent="Аввал ҷавобро навис.";
  return;
 }

 answered=true;
 $("answer").disabled=true;

 const correct=questions[index][0];
 const success=normalize(input)===normalize(correct);

 $("feedback").style.display="block";

 if(success){
  score++;
  state.xp+=5;

  try{
   localStorage.setItem(KEY,JSON.stringify(state));
  }catch(e){
   console.warn("XP нигоҳ дошта нашуд",e);
  }

  $("feedback").className="feedback correct";
  $("feedback").textContent="✅ Дуруст! +5 XP";
 }else{
  $("feedback").className="feedback wrong";
  $("feedback").textContent=
   "❌ Ҷавоби дуруст: "+correct;
 }

 $("score").textContent=score;
 renderXP();

 $("check").classList.add("hidden");
 $("next").classList.remove("hidden");
}

function next(){
 if(!answered)return;
 index++;
 showQuestion();
}

function finish(){
 $("exercise").classList.add("hidden");
 $("result").classList.remove("hidden");

 $("counter").textContent=questions.length+
 "/"+questions.length;

 $("bar").style.width="100%";

 $("finalScore").textContent=
 score+" / "+questions.length;

 $("finalMessage").textContent=
 score>=8?
 "🌟 Офарин! Натиҷаи аъло!":
 score>=5?
 "👍 Хуб! Машқро идома деҳ.":
 "📚 Боз машқ кун, натиҷа беҳтар мешавад.";
}

$("start").addEventListener("click",start);
$("check").addEventListener("click",check);
$("next").addEventListener("click",next);
$("again").addEventListener("click",start);

$("answer").addEventListener("keydown",e=>{
 if(e.key!=="Enter")return;
 if(answered)next();
 else check();
});

if(DATA[state.lang]){
 $("language").value=state.lang;
}

renderXP();
</script>
</body>
</html>
