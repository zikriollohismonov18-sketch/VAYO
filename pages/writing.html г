
<!DOCTYPE html>
<html lang="tg">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#7355ef">
<title>VAYO — Машқи навиштан</title>
<style>
:root{
 --purple:#7355ef;
 --green:#22ae73;
 --red:#e85269;
 --bg:#f5f5fd;
 --ink:#24213e;
 --line:#e7e4f3
}
*{box-sizing:border-box}
body{
 margin:0;
 background:var(--bg);
 color:var(--ink);
 font-family:Arial,sans-serif
}
header{
 background:linear-gradient(120deg,#5e4bdc,#a36af5);
 color:white;
 padding:24px 15px
}
.wrap{max-width:750px;margin:auto;padding:15px}
header h1{margin:10px 0}
a{color:inherit}
.back{
 display:inline-block;
 padding:10px 14px;
 border-radius:12px;
 background:#ffffff26;
 text-decoration:none
}
.card{
 background:white;
 border:1px solid var(--line);
 border-radius:18px;
 padding:18px;
 margin:15px 0
}
.stats{
 display:grid;
 grid-template-columns:repeat(3,1fr);
 gap:10px
}
.stat{text-align:center}
.stat b{display:block;font-size:22px}
small{color:#77758b}
select,input{
 width:100%;
 padding:15px;
 border:2px solid var(--line);
 border-radius:12px;
 font-size:17px;
 background:white
}
input:focus{
 outline:none;
 border-color:var(--purple)
}
button{
 border:0;
 cursor:pointer;
 font:inherit
}
.btn{
 padding:14px;
 border-radius:12px;
 font-weight:bold
}
.primary{background:var(--purple);color:white}
.green{background:var(--green);color:white}
.light{background:#efecfa;color:var(--ink)}
.actions{
 display:grid;
 grid-template-columns:1fr 1fr;
 gap:10px;
 margin-top:15px
}
.question{
 background:#f6f3ff;
 padding:25px 15px;
 border-radius:16px;
 text-align:center;
 margin:20px 0
}
.question strong{
 font-size:25px;
 line-height:1.5
}
.feedback{
 padding:15px;
 border-radius:12px;
 margin:15px 0;
 line-height:1.6;
 display:none
}
.correct{background:#e5f9ee;color:#176b48}
.wrong{background:#ffe8ed;color:#9b2841}
.progress{
 background:#e9e7f5;
 height:12px;
 border-radius:20px;
 overflow:hidden
}
.fill{
 background:var(--green);
 height:100%;
 width:0%;
 transition:width .2s
}
.hidden{display:none!important}
#answer{margin-top:12px}
@media(max-width:450px){
 .stats{grid-template-columns:repeat(3,1fr)}
 .stat b{font-size:18px}
}
</style>
</head>
<body>

<header>
<div class="wrap">
 <a class="back" href="language.html">
  ← VAYO Language
 </a>
 <h1>✍️ Машқи навиштан</h1>
 <p>Калимаҳоро омӯз ва худат навис!</p>
</div>
</header>

<main class="wrap">

<div class="stats">
 <div class="card stat">
  <b id="xp">0</b>
  <small>⚡ XP</small>
 </div>
 <div class="card stat">
  <b id="score">0</b>
  <small>✅ Дуруст</small>
 </div>
 <div class="card stat">
  <b id="counter">0/10</b>
  <small>📝 Савол</small>
 </div>
</div>

<section class="card">
 <h2>🌍 Забонро интихоб кун</h2>
 <select id="language">
  <option value="de">🇩🇪 Олмонӣ</option>
  <option value="en">🇬🇧 Англисӣ</option>
  <option value="ru">🇷🇺 Русӣ</option>
  <option value="zh">🇨🇳 Чинӣ</option>
  <option value="ko">🇰🇷 Кореягӣ</option>
 </select>

 <h3>🎓 Сатҳи машқ</h3>
 <select id="level">
  <option value="A1">A1 — Оғозӣ</option>
  <option value="A2">A2 — Ибтидоӣ</option>
 </select>

 <button id="start" class="btn primary"
 style="width:100%;margin-top:15px">
  ▶ Оғози машқ
 </button>
</section>

<section class="card hidden" id="exercise">
 <h2>📝 Ҷавобро навис</h2>
 <div class="progress">
  <div class="fill" id="bar"></div>
 </div>
 <div class="question">
  <small>Ба забони интихобшуда тарҷума кун:</small>
  <div style="margin-top:15px">
   <strong id="question"></strong>
  </div>
 </div>
 <input id="answer"
  placeholder="Ҷавобро дар ин ҷо навис..."
  autocomplete="off"
  autocapitalize="off">

 <div id="feedback" class="feedback"></div>

 <div class="actions">
  <button class="btn primary" id="check">
   Санҷидан ✓
  </button>
  <button class="btn green hidden" id="next">
   Давом додан →
  </button>
 </div>
</section>

<section class="card hidden" id="result">
 <h2>🏆 Машқ анҷом ёфт!</h2>
 <div class="question">
  <strong id="finalScore"></strong>
  <p id="finalMessage"></p>
 </div>
 <button id="again" class="btn primary"
 style="width:100%">
  🔄 Боз машқ кардан
 </button>
</section>

</main>

<script>
"use strict";

const $=id=>document.getElementById(id);

const KEY="vayo_language_v2";

function load(){
 try{
  return JSON.parse(localStorage.getItem(KEY))||{};
 }catch(e){
  return {};
 }
}

const state=load();

if(!state.done)state.done={};
if(!Number.isFinite(Number(state.xp)))state.xp=0;
state.xp=Number(state.xp)||0;

const DATA={
de:{
 A1:[
