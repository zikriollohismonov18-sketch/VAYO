 ["Hello","Салом"],
 ["Good morning","Субҳ ба хайр"],
 ["Thank you","Ташаккур"],
 ["Please","Лутфан"],
 ["Water","Об"],
 ["Bread","Нон"],
 ["Mother","Модар"],
 ["Father","Падар"],
 ["Work","Кор"],
 ["Today","Имрӯз"],
 ["Tomorrow","Пагоҳ"],
 ["I am sick.","Ман беморам."],
 ["What is your name?","Номат чист?"],
 ["How are you?","Аҳволат чӣ хел?"],
 ["Where is the station?","Истгоҳ дар куҷост?"]
 ],
 A2:[
 ["I have to work today.","Ман бояд имрӯз кор кунам."],
 ["I am looking for an apartment.","Ман манзил меҷӯям."],
 ["I have an appointment.","Ман вақти қабул дорам."],
 ["I would like to book a room.","Ман мехоҳам ҳуҷра банд кунам."],
 ["I am learning English.","Ман англисӣ меомӯзам."],
 ["I need help.","Ман ба ёрӣ ниёз дорам."],
 ["I worked yesterday.","Ман дирӯз кор кардам."],
 ["How much is the rent?","Иҷорапулӣ чанд аст?"],
 ["I need to transfer money.","Ман бояд пул интиқол диҳам."],
 ["Could you repeat that?","Метавонед инро такрор кунед?"]
 ]
},
ru:{
 A1:[
 ["Привет","Салом"],
 ["Доброе утро","Субҳ ба хайр"],
 ["Спасибо","Ташаккур"],
 ["Пожалуйста","Марҳамат"],
 ["Вода","Об"],
 ["Хлеб","Нон"],
 ["Мать","Модар"],
 ["Отец","Падар"],
 ["Работа","Кор"],
 ["Сегодня","Имрӯз"],
 ["Завтра","Пагоҳ"],
 ["Я болею.","Ман беморам."],
 ["Как тебя зовут?","Номат чист?"],
 ["Как дела?","Аҳволат чӣ хел?"],
 ["Где вокзал?","Истгоҳи қатора дар куҷост?"]
 ],
 A2:[
 ["Я должен сегодня работать.","Ман бояд имрӯз кор кунам."],
 ["Я ищу квартиру.","Ман манзил меҷӯям."],
